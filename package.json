{
  "name": "cendekia-muda",
  "version": "0.1.0",
  "private": true,
  "description": "Cendekia Muda: frontend dan fondasi API Node.js + Express",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch server/src/server.js",
    "start": "node server/src/server.js",
